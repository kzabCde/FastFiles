{
  "name": "fastfiles",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:a11y": "playwright test tests/a11y-gate.spec.ts",
    "test:visual": "playwright test tests/visual-regression.spec.ts --project=chromium",
    "quality": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e && npm run test:visual"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "^15.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
